# Copie para .env. Nunca versione credenciais.
# Use um projeto no Free Tier do Google AI Studio para o teste sem cobrança.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# IDs numéricos separados por vírgula. Vazio recusa todos os usuários.
TELEGRAM_ALLOWED_USER_IDS=
POSTGRES_DB=bi_sintetico
POSTGRES_USER=bi_owner
POSTGRES_PASSWORD=troque_a_senha_admin
READONLY_PASSWORD=troque_a_senha_leitura
POSTGRES_PORT=55432
# Configure URLs com senhas percent-encoded caso contenham caracteres especiais.
ADMIN_DATABASE_URL=postgresql://bi_owner:troque_a_senha_admin@localhost:55432/bi_sintetico
DATABASE_URL=postgresql://readonly_agent:troque_a_senha_leitura@localhost:55432/bi_sintetico
QUERY_TIMEOUT_MS=3000
MAX_QUERY_ROWS=100
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=1000
MAX_HISTORY_TURNS=8
